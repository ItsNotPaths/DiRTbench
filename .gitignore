vendor/
# The release build's own vendor archives, compiled on glibc 2.28. Kept apart
# from vendor/ so a host-built archive can never raise the floor of a release.
vendor-alma8/
build/

# Byte-level format notes, the plan and the handoff roadmaps. Derived from
# reading the user's own game files; not ours to redistribute.
docs/
out/

# The Python and shell side of the Dirt 3 work: probes, one-off surgery on an
# installed game, and the Ghidra scripts behind the binary notes. Scratch, and
# several of them write into a real game directory.
tools/

# Recorded co-driver lines. Committed separately, with their credit.
assets/pacenotes/*
!assets/pacenotes/.gitkeep

# DiRT 3 shader metadata, cut out of two stock venues and kept as test
# fixtures. Not ours to redistribute, and no release binary carries them: they
# are reached only from _test.odin files, which `odin build` skips. Without
# them the d3 suite reports the fixtures as missing and the build still works.
assets/d3/*-materials.pssg

# Machine-local settings: where the game is installed, and anything else that
# differs per machine. Often a path inside a Proton prefix. Grammar and keys are
# in src/app/config.odin.
dirtbench.conf

# ImGui writes its window layout next to the running binary. Per-machine state,
# not project config; a committed copy pins everyone's panels to whoever ran the
# editor last.
imgui.ini

# Rendered previews of parsed game data, regenerated from a real install.
imgs/
